{
  "name": "orgnote-excalidraw",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run clear && bun run build:runtime && bun run generate:assets && bun run build:entry",
    "build:entry": "vite build --mode entry",
    "build:runtime": "vite build --mode runtime",
    "clear": "rm -rf dist",
    "generate:assets": "bun scripts/generate-assets.ts",
    "lint": "eslint -c eslint.config.js \"src/**/*.{ts,vue}\" \"scripts/**/*.ts\" vite.config.ts",
    "test": "vitest",
    "test:ci": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "verify:release": "bun run build && bun scripts/verify-release.ts && bun scripts/smoke-release.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.14.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-vue": "5.2.3",
    "@vue/eslint-config-typescript": "14.7.0",
    "@vue/test-utils": "2.4.6",
    "eslint": "10.4.0",
    "eslint-plugin-vue": "10.9.1",
    "globals": "16.0.0",
    "happy-dom": "17.6.3",
    "orgnote-api": "file:../orgnote-api/dist",
    "typescript": "5.8.3",
    "vite": "6.3.2",
    "vitest": "3.1.2",
    "vitest-canvas-mock": "0.3.3",
    "vue": "3.5.13",
    "vue-eslint-parser": "10.1.4",
    "vue-tsc": "2.2.8"
  }
}
